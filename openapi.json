  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key",
        "description": "Use the API key configured as the Worker's API_KEY secret."
      }
    },
    "parameters": {
      "MailboxId": {
        "name": "mailboxId",
        "in": "path",
        "required": true,
        "description": "Mailbox email address, URL-encoded when needed.",
        "schema": {
          "type": "string",
          "format": "email"
        }
      },
      "EmailId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "EmailIdByEmailId": {
        "name": "emailId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ThreadId": {
        "name": "threadId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "FolderId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
