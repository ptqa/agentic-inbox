{
  "openapi": "3.1.0",
  "info": {
    "title": "BirthPath Support Inbox API",
    "version": "1.0.0",
    "description": "REST API for managing BirthPath support mailboxes, messages, drafts, folders, threads, search, and attachments.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "https://api.inbox.birthpath.app"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Discovery",
      "description": "API metadata and runtime configuration."
    },
    {
      "name": "Mailboxes",
      "description": "Mailbox creation, settings, and removal."
    },
    {
      "name": "Emails",
      "description": "Email, draft, reply, and forwarding operations."
    },
    {
      "name": "Threads",
      "description": "Conversation retrieval and read state."
    },
    {
      "name": "Folders",
      "description": "Mailbox folder management."
    },
    {
      "name": "Search",
      "description": "Filtered mailbox search."
    },
    {
      "name": "Attachments",
      "description": "Binary attachment downloads."
    }
  ],
  "paths": {
    "/api/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "summary": "Get the OpenAPI document",
        "tags": [
          "Discovery"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
